# MyProfile Mobile App (Expo / React Native) - Environment Configuration
# API base URL pointing to the MyProfile Backend Gateway
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# For Production (e.g. Vercel deployment or Mobile APK):
# EXPO_PUBLIC_API_URL=https://myprofile-official-api.vercel.app/api/v1

# Cloudinary CDN Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
