{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://myprofile-official-api.vercel.app/api/v1",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "gphexfmz",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "myprofile_reels"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://myprofile-official-api.vercel.app/api/v1",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "gphexfmz",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "myprofile_reels"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
