# MyProfile Web Application - Environment Configuration
# API base URL pointing to the MyProfile Backend Gateway
VITE_API_URL=http://localhost:5000/api/v1

# For Production (e.g. Vercel deployment):
# VITE_API_URL=https://myprofile-official-api.vercel.app/api/v1

# Cloudinary CDN Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
